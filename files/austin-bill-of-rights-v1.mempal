      "pao" : {
        "person" : "A county sheriff",
        "action" : "holding up a warrant as the bats pour out to search the crowd on the bridge",
        "object" : "a warrant naming the place and the things to be seized",
        "notes" : "Fourth Amendment: no unreasonable searches and seizures, and no warrant without probable cause, sworn, naming the place and the things. At dusk the bats pour out from under the bridge and swoop through every pocket and handbag along the railing, seizing whatever they like, until the sheriff holds up a sworn warrant that names the place and the things: no warrant, no search."
      }
